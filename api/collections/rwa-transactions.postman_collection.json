  "item": [
    {
      "name": "POST /login (valid)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const userId = pm.response.json().user.id;",
              "pm.environment.set('userId', userId);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET /transactions schema",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has pageData object', function () {",
              "  const jsonData = pm.response.json();",
              "  pm.expect(jsonData.pageData).to.be.an('object');",
              "  pm.expect(jsonData.pageData.page).to.be.a('number');",
              "  pm.expect(jsonData.pageData.limit).to.be.a('number');",
              "  pm.expect(jsonData.pageData.hasNextPages).to.be.a('boolean');",
              "  pm.expect(jsonData.pageData.totalPages).to.be.a('number');",
              "});",
              "",
              "pm.test('Response has results array', function () {",
              "  const jsonData = pm.response.json();",
              "  pm.expect(jsonData.results).to.be.an('array');",
              "});",
              "",
              "pm.test('Each transaction has required schema fields', function () {",
              "  const jsonData = pm.response.json();",
              "  const requiredFields = ['id', 'uuid', 'amount', 'description', 'receiverId', 'senderId', 'privacyLevel', 'status', 'createdAt', 'modifiedAt'];",
              "  jsonData.results.forEach(function (transaction) {",
              "    requiredFields.forEach(function (field) {",
              "      pm.expect(transaction).to.have.property(field);",
              "    });",
              "    pm.expect(transaction.id).to.be.a('string').that.is.not.empty;",
              "    pm.expect(transaction.amount).to.be.a('number');",
              "    pm.expect(transaction.status).to.be.a('string').that.is.not.empty;",
              "  });",
              "});",
              "",
              "const firstTransaction = pm.response.json().results[0];",
              "if (firstTransaction) {",
              "  pm.environment.set('transactionId', firstTransaction.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transactions"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET /transactions/{{transactionId}} schema",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Transaction detail has required schema fields', function () {",
              "  const transaction = pm.response.json().transaction;",
              "  const requiredFields = ['id', 'uuid', 'amount', 'description', 'receiverId', 'senderId', 'privacyLevel', 'status', 'createdAt', 'modifiedAt'];",
              "  requiredFields.forEach(function (field) {",
              "    pm.expect(transaction).to.have.property(field);",
              "  });",
              "  pm.expect(transaction.id).to.be.a('string').that.is.not.empty;",
              "  pm.expect(transaction.amount).to.be.a('number');",
              "  pm.expect(transaction.status).to.be.a('string').that.is.not.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/transactions/{{transactionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transactions",
            "{{transactionId}}"
          ]
        }
      },
      "response": []
    }
  ],
