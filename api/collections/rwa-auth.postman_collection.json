              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('results is an array', function () {",
              "  const jsonData = pm.response.json();",
              "  pm.expect(jsonData.results).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET /users/{{userId}}",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Profile matches the logged-in user', function () {",
              "  const jsonData = pm.response.json();",
              "  pm.expect(jsonData.user.id).to.equal(pm.environment.get('userId'));",
              "  pm.expect(jsonData.user.username).to.equal(pm.environment.get('username'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
